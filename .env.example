# Másold .env-be és állítsd be. Minden mezőnek van értelmes alapértéke,
# helyi fejlesztéshez a fájl akár el is hagyható.

PORT=3000

# Melyik interfészen figyeljen. Üresen hagyva MINDEGYIKEN — ez kell helyi
# fejlesztéshez (LAN-ról, telefonról is elérhető). Éles kiszolgálón, Apache
# reverse proxy mögött írd be a 127.0.0.1-et, különben a PORT kívülről
# közvetlenül is elérhető, megkerülve a HTTPS-t.
HOST=

# A fejlesztői mentések (rajtrács, kapuk, zónatérkép, ütközési háló) lemezre
# írnak, és NINCS mögöttük jogosultság-ellenőrzés. Éles kiszolgálón: 0
ALLOW_DEV_WRITES=1

# Online fizika: server = a szerver szimulál és korrigál; client = minden
# játékos a saját autóját számolja, a szerver az állapotot és a versenyt kezeli.
# A client mód nagy pingnél sokkal közvetlenebb, de csalás ellen nem véd.
PHYSICS_AUTHORITY=server

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=racing
